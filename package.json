{
  "name": "cumplista",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "tsx watch src/entry-node.ts",
    "start": "tsx src/entry-node.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply cumplista --local"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "hono": "^4.13.18",
    "@hono/node-server": "^2.1.8",
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
